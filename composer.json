{
    "name": "sulcompany/router",
    "description": "A lightweight, dependency-free PHP router with dynamic routes, middleware, route groups, contexts, and built-in error handling.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "router",
        "routing",
        "php-router",
        "http",
        "middleware",
        "psr-11",
        "psr-container",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/sulcompany/router",
    "support": {
        "issues": "https://github.com/sulcompany/router/issues",
        "source": "https://github.com/sulcompany/router"
    },


    "authors": [
        {
            "name": "Francisco Dulo",
            "email": "franciscojob14@hotmail.com"
        },

        {
            "name": "Sul Company Lda",
            "email": "sulcompany14@gmail.com"
        }
    ],


    "require": {
        "php": "^8.1",
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SulCompany\\Router\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}